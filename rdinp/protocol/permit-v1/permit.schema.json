{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rdinp:reusable-permit:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revision": {
      "const": "RDINP-REUSABLE-PERMIT-1"
    },
    "kind": {
      "enum": [
        "ISSUE",
        "PERMIT_TOKEN",
        "PERMIT",
        "SNAPSHOT",
        "SNAPSHOT_REPLY",
        "TASK",
        "SELECT",
        "OFFER",
        "RESULT",
        "REJECT",
        "AUDIT",
        "AUDIT_REPLY"
      ]
    },
    "sender": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "correlation": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "body": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "value": {
          "type": "string",
          "minLength": 128,
          "maxLength": 2000
        }
      },
      "required": [
        "kid",
        "value"
      ]
    }
  },
  "required": [
    "revision",
    "kind",
    "sender",
    "recipient",
    "nonce",
    "correlation",
    "payload_sha256",
    "body",
    "signature"
  ],
  "$defs": {
    "ISSUE": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "max_budget_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        }
      },
      "required": [
        "session",
        "ttl_ms",
        "max_tasks",
        "max_slots",
        "max_input_bytes",
        "max_budget_ms"
      ]
    },
    "PERMIT_TOKEN": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "authority_epoch": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "max_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "max_budget_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        },
        "issued_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tiers": {
          "const": [
            "main",
            "light",
            "local"
          ]
        }
      },
      "required": [
        "session",
        "generation",
        "authority_epoch",
        "max_tasks",
        "max_slots",
        "max_input_bytes",
        "max_budget_ms",
        "issued_ns",
        "expires_ns",
        "tiers"
      ]
    },
    "PERMIT": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "PERMIT"
        },
        "permit": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "permit"
      ]
    },
    "SNAPSHOT": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "SNAPSHOT_REPLY": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "SNAPSHOT"
        },
        "authority_epoch": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "observed_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "busy_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "queued_tasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wait_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "service_estimate_ns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "main": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "light": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "main",
            "light"
          ]
        }
      },
      "required": [
        "status",
        "authority_epoch",
        "observed_ns",
        "busy_slots",
        "queued_tasks",
        "wait_ns",
        "slots",
        "service_estimate_ns"
      ]
    },
    "TASK": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permit": {
          "type": "object"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_tier": {
          "enum": [
            "main",
            "light"
          ]
        },
        "accepted_tier": {
          "enum": [
            "main",
            "light"
          ]
        },
        "release_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "edge_cutoff_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "post_upload": {
          "enum": [
            "none",
            "auto",
            "offer"
          ]
        },
        "tail_budget_ns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "main": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "light": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "main",
            "light"
          ]
        }
      },
      "required": [
        "permit",
        "task_id",
        "input_sha256",
        "input_tier",
        "accepted_tier",
        "release_ns",
        "edge_cutoff_ns",
        "deadline_ns",
        "post_upload",
        "tail_budget_ns"
      ]
    },
    "SELECT": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permit": {
          "type": "object"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tier": {
          "const": "light"
        }
      },
      "required": [
        "permit",
        "task_id",
        "input_sha256",
        "tier"
      ]
    },
    "OFFER": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "OFFER"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "session": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "authority_epoch": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "tier": {
          "enum": [
            "main",
            "light"
          ]
        },
        "edge_cutoff_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ready_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "task_id",
        "input_sha256",
        "session",
        "generation",
        "authority_epoch",
        "tier",
        "edge_cutoff_ns",
        "ready_ns"
      ]
    },
    "RESULT": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "RESULT"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "session": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "authority_epoch": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "tier": {
          "enum": [
            "main",
            "light"
          ]
        },
        "edge_cutoff_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ready_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "queue_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "service_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "task_id",
        "input_sha256",
        "session",
        "generation",
        "authority_epoch",
        "tier",
        "edge_cutoff_ns",
        "ready_ns",
        "result_sha256",
        "queue_ns",
        "service_ns",
        "complete_ns"
      ]
    },
    "REJECT": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "REJECT"
        },
        "reason": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        }
      },
      "required": [
        "status",
        "reason"
      ]
    },
    "AUDIT": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        }
      },
      "required": []
    },
    "AUDIT_REPLY": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "AUDIT"
        },
        "effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "starts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "task_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tasks": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "principal": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              "task_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "session": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              "generation": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "state": {
                "enum": [
                  "queued",
                  "offered",
                  "running",
                  "complete",
                  "failed"
                ]
              },
              "starts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "effects": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "result_sha256": {
                "anyOf": [
                  {
                    "const": ""
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                ]
              }
            },
            "required": [
              "principal",
              "task_id",
              "input_sha256",
              "session",
              "generation",
              "state",
              "starts",
              "effects",
              "result_sha256"
            ]
          }
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "effects",
        "starts",
        "task_count",
        "tasks",
        "next_offset"
      ]
    }
  }
}
