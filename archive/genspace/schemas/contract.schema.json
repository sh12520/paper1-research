{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genspace.invalid/schemas/contract.schema.json",
  "title": "Public contract AST (depth is checked separately)",
  "$ref": "#/$defs/clause",
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["quality", "deadline", "rate"],
      "properties": {
        "quality": {"type": "number", "minimum": 0, "maximum": 1},
        "deadline": {"type": "number", "exclusiveMinimum": 0},
        "rate": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "clause": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "profile"], "properties": {"type": {"const": "Static"}, "profile": {"$ref": "#/$defs/profile"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "condition", "then_clause", "else_clause"], "properties": {"type": {"const": "If"}, "condition": {"type": "string", "minLength": 1}, "then_clause": {"$ref": "#/$defs/clause"}, "else_clause": {"$ref": "#/$defs/clause"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "duration", "first", "second"], "properties": {"type": {"const": "Sequence"}, "duration": {"type": "integer", "minimum": 1}, "first": {"$ref": "#/$defs/clause"}, "second": {"$ref": "#/$defs/clause"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "offset", "clause"], "properties": {"type": {"const": "Delay"}, "offset": {"type": "integer", "minimum": 1}, "clause": {"$ref": "#/$defs/clause"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "interval", "clause"], "properties": {"type": {"const": "ValidFor"}, "interval": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 2, "maxItems": 2}, "clause": {"$ref": "#/$defs/clause"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "level", "clause"], "properties": {"type": {"const": "Offload"}, "level": {"type": "string", "minLength": 1}, "clause": {"$ref": "#/$defs/clause"}}}
      ]
    }
  }
}
